{
  "name": "majix-tools",
  "version": "0.2.0",
  "description": "Panel de desarrollo para webs hechas con Vite: Web Vitals, Search Console, archivos, consola, red y rutas mientras construyes. Cero bytes en producción.",
  "keywords": [
    "vite",
    "vite-plugin",
    "devtools",
    "web-vitals",
    "core-web-vitals",
    "search-console",
    "performance",
    "react",
    "majix"
  ],
  "license": "MIT",
  "author": "MAJIX <contact@majixlab.com> (https://majixlab.com)",
  "homepage": "https://majixlab.com/open-source/majix-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majixgroup/majix-tools.git"
  },
  "bugs": "https://github.com/majixgroup/majix-tools/issues",
  "type": "module",
  "bin": {
    "majix-tools": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./cliente": {
      "types": "./dist/cliente.d.ts",
      "default": "./dist/cliente.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integracion": "npm run build && node test/integracion.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:integracion"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.575.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
